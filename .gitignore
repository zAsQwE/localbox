# Node
node_modules/
npm-debug.log*

# Локальные артефакты (генерируются лаунчером — не публикуются)
config.json
launcher/localbox-settings.json
launcher/install-paths.json
dist/
certs/
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# Бэкапы патчей игр
*.localbox-backup
*.localbox-original
.localbox-pack12-*

# Кэш/временное
cache/
*.part

# Рантайм-данные сервера и модели TTS (качаются/клонируются сами)
storage/
server/tts/*.pt
server/tts/piper/

# Большие веб-клиенты (ассеты Jackbox) — скачиваются отдельно из источников, см. README.
# НЕ коммитим: слишком велики и не наши.
client/
client-ru/
client-fun/
runtime/

# Локальные сборки Python-лаунчера
launcher/build/
launcher/dist/
*.spec

# Ассеты рендера Додо Ре Ми (инструменты/песни, большие, не наши)
server/render/

# Локальные проверки — не входят в репозиторий и установщики
/server/test/
/launcher/test_*.py
/installer/test_*.py
/tools/test_*.py
/docs/testing.md
/docs/testing.en.md

# Журналы и временные параметры установки
*.log
*.tmp
/installer/setup-options.ini
/.localbox-update.lock
/.localbox-update-*/
